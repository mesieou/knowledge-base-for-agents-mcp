# Canonical image to deploy.
# For pinned deploys, use an immutable tag like:
# ghcr.io/mesieou/knowledge-base-for-agents-mcp:sha-<git-sha>
MCP_IMAGE=ghcr.io/mesieou/knowledge-base-for-agents-mcp:sha-REPLACE_ME

# Compose/runtime settings
COMPOSE_PROJECT_NAME=knowledge-base-mcp
MCP_CONTAINER_NAME=knowledge-base-mcp
MCP_BIND_HOST=0.0.0.0
MCP_PUBLISHED_PORT=8000
MCP_ENV_FILE=.env

# Runtime secrets and parity settings
OPENAI_API_KEY=replace_me
DATABASE_URL=postgresql://replace_me
BUSINESS_ID=00000000-0000-0000-0000-000000000000

# Optional crawler tuning
MAX_DOCUMENT_WORDS=10000
MIN_DELAY_SECONDS=1.0
REQUEST_TIMEOUT=15
